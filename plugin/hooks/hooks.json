{
  "hooks": {
    "SessionStart": [
      {"hooks": [{"type": "command", "command": "@@VIOLA_BIN@@", "args": ["hook", "session-start"], "timeout": 5}]}
    ],
    "UserPromptSubmit": [
      {"hooks": [{"type": "command", "command": "@@VIOLA_BIN@@", "args": ["hook", "user-prompt-submit"], "timeout": 5}]}
    ],
    "PreToolUse": [
      {"matcher": "AskUserQuestion|ExitPlanMode", "hooks": [{"type": "command", "command": "@@VIOLA_BIN@@", "args": ["hook", "pre-tool-use"], "timeout": 75}]}
    ],
    "PermissionRequest": [
      {"hooks": [{"type": "command", "command": "@@VIOLA_BIN@@", "args": ["hook", "permission-request"], "timeout": 75}]}
    ],
    "Stop": [
      {"hooks": [{"type": "command", "command": "@@VIOLA_BIN@@", "args": ["hook", "stop"], "timeout": 5}]}
    ],
    "SessionEnd": [
      {"hooks": [{"type": "command", "command": "@@VIOLA_BIN@@", "args": ["hook", "session-end"]}]}
    ],
    "Notification": [
      {"hooks": [{"type": "command", "command": "@@VIOLA_BIN@@", "args": ["hook", "notification"], "async": true}]}
    ],
    "PostToolUse": [
      {"hooks": [{"type": "command", "command": "@@VIOLA_BIN@@", "args": ["hook", "post-tool-use"], "async": true}]}
    ],
    "PostToolUseFailure": [
      {"hooks": [{"type": "command", "command": "@@VIOLA_BIN@@", "args": ["hook", "post-tool-use-failure"], "async": true}]}
    ]
  }
}
