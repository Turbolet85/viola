".claude/rules/testing.md": [
134,
"- 2026-11-25: A case whose start must end before its session starts (a not-resumed or otherwise sessionless child) cannot go through `Wrapper::adopt` or any readiness-waiting test wrapper, which waits for a readiness that start never reaches: run the verb piped outside a terminal, as `tests/cli_up.rs`'s sessionless start does, and read stdout and stderr apart.",
135
],
".claude/rules/verification-harness.md": [
81,
"- 2026-11-24: A live-reading script prints verdict words from its plan's closed set alone: a state the set names no word for takes the set's nearest word (a hand wrapper never live reads `unread`), never a new word, and its rehearsal is fired again after the change.",
82
],
"CLAUDE.md": [
136,
"<!-- USER:session-learnings end -->",
137
]
},
